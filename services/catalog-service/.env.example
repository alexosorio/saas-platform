# Base de datos (la BD real con schema gets_shared)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=saas_platform
DB_USER=postgres
DB_PASSWORD=postgres

# JWT - DEBE ser identico al del user-service (puerto 8082)
JWT_SECRET=ClaveSecretaCompartidaSaaSPlatform256BitsMinimoParaHS512SeguraYLarga

SERVER_PORT=8083

# CORS: orígenes del frontend separados por comas (producción: https://app.tudominio.com)
CORS_ORIGINS=*
