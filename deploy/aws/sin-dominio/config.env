# Valores de TU despliegue sin dominio. Edítalos y guarda; los usan los scripts de esta carpeta.
# Vacío = la región de "aws configure". Cuentas creadas con el registro nuevo desde Colombia: us-east-2
REGION=
CLUSTER=saas-prod

# Paso A: el "Distribution domain name" de CloudFront, sin https:// ni barra final
CF_DOMAIN=d1a2b3c4d5e6f7.cloudfront.net

# Guía principal, paso 5 y paso 7
RDS_ENDPOINT=saas-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
EFS_ID=fs-0123456789abcdef0

# Etiqueta que imprimió build-push.sh
TAG=20261114-1600

# Paso F: el correo que verificaste en SendGrid (Single Sender)
MAIL_FROM=tu-correo@gmail.com
MAIL_FROM_NAME=Tu Plataforma
BRAND_NAME=Tu Plataforma

# WhatsApp (opcional): déjalo vacío si aún no lo usas
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
