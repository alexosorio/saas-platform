{
  "family": "saas-catalog-service",
  "networkMode": "awsvpc", "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024", "memory": "2048",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT__:role/ecsTaskExecutionRole",
  "volumes": [{ "name": "uploads",
    "efsVolumeConfiguration": { "fileSystemId": "__EFS_ID__", "transitEncryption": "ENABLED" } }],
  "containerDefinitions": [{
    "name": "app",
    "image": "__ACCOUNT__.dkr.ecr.__REGION__.amazonaws.com/saas/catalog-service:__TAG__",
    "essential": true,
    "portMappings": [{ "containerPort": 8083 }],
    "mountPoints": [{ "sourceVolume": "uploads", "containerPath": "/data/uploads" }],
    "environment": [
      { "name": "SERVER_PORT", "value": "8083" },
      { "name": "SERVER_SERVLET_CONTEXT_PATH", "value": "/api-catalogo" },
      { "name": "DB_HOST", "value": "__RDS_ENDPOINT__" },
      { "name": "DB_PORT", "value": "5432" },
      { "name": "DB_NAME", "value": "saas_platform" },
      { "name": "DB_USER", "value": "saas_app" },
      { "name": "RABBITMQ_HOST", "value": "rabbitmq.saas.local" },
      { "name": "RABBITMQ_PORT", "value": "5672" },
      { "name": "RABBITMQ_USER", "value": "saas" },
      { "name": "PUBLIC_BASE_URL", "value": "https://__CF_DOMAIN__/catalog" },
      { "name": "UPLOADS_DIR", "value": "/data/uploads" },
      { "name": "CORS_ORIGINS", "value": "https://__CF_DOMAIN__" },
      { "name": "MAIL_FROM", "value": "__MAIL_FROM__" },
      { "name": "MAIL_FROM_NAME", "value": "__MAIL_FROM_NAME__" },
      { "name": "WHATSAPP_PHONE_NUMBER_ID", "value": "__WHATSAPP_PHONE_NUMBER_ID__" },
      { "name": "WHATSAPP_API_VERSION", "value": "__WHATSAPP_API_VERSION__" },
      { "name": "LOG_LEVEL", "value": "INFO" }
    ],
    "secrets": [
      { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/saas/prod/DB_PASSWORD" },
      { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/saas/prod/JWT_SECRET" },
      { "name": "RABBITMQ_PASSWORD", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/saas/prod/RABBITMQ_PASSWORD" },
      { "name": "SENDGRID_API_KEY", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/saas/prod/SENDGRID_API_KEY" },
      { "name": "WHATSAPP_ACCESS_TOKEN", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/saas/prod/WHATSAPP_ACCESS_TOKEN" }
    ],
    "logConfiguration": { "logDriver": "awslogs", "options": {
      "awslogs-group": "/ecs/saas-prod", "awslogs-region": "__REGION__", "awslogs-stream-prefix": "catalog-service" } }
  }]
}
